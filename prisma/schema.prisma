generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // THIS ISN'T AN ERROR JUST A WARNING LEAVE IT
  url = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  REVIEWER
  INSPECTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id String @id @default(cuid())

  clerkUserId String @unique

  name      String?
  email     String @unique
  imageUrl  String?

  role   UserRole   @default(CONSUMER)
  status UserStatus @default(ACTIVE)

  roleChangesMade RoleChangeLog[] @relation("ChangedBy")
  roleChanges     RoleChangeLog[] @relation("TargetUser")
  citizenReports  CitizenReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleChangeLog {
  id String @id @default(cuid())

  userId String
  changedById String

  oldRole UserRole
  newRole UserRole

  createdAt DateTime @default(now())

  user      User @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User @relation("ChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([changedById])
  @@index([createdAt])
}

model CitizenReport {
  id String @id @default(cuid())

  reportNumber String @unique
  userId String
  scanId String?

  issueType String
  description String
  status String @default("SUBMITTED")

  shopName String
  shopkeeperName String?
  shopAddress String?
  shopCity String?
  shopState String?
  shopPinCode String?

  latitude Float?
  longitude Float?
  locationAccuracy Float?

  productSnapshot Json?
  analysisSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence CitizenReportEvidence[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CitizenReportEvidence {
  id String @id @default(cuid())

  reportId String
  storageKey String @unique
  originalFileName String?
  mimeType String
  sizeBytes Int
  imageType String?

  createdAt DateTime @default(now())

  report CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}
